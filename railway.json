{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "context": ".",
    "dockerfile": "infrastructure/docker/Dockerfile.api"
  },
  "deploy": {
    "startCommand": "node dist/main.js",
    "numReplicas": 2,
    "restartPolicyType": "always",
    "restartPolicyMaxRetries": 5
  },
  "variables": {
    "PORT": "3001",
    "NODE_ENV": "production"
  }
}
